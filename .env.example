# Copy to .env — never commit .env
# Restart Metro after changes: npx expo start --clear

EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GROQ_API_KEY=

# P2.1 Web Auth (public client values; security = RLS). Never put service-role here.
# Use either ANON_KEY or PUBLISHABLE_KEY (dashboard name) — same public client role.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
